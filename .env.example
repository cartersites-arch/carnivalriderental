# Copy to .env.local (or run `npm run setup`, which generates random secrets).
# Never commit real secrets. This project has NO production credentials.

# development | preview | production
APP_ENV=development
# Canonical origin used for canonical URLs and sitemap entries.
SITE_URL=http://localhost:3000
# Candidate production domain (provided by founder; not yet live, not approved for indexing): https://carnivalriderental.us
# Public indexing is only honoured when APP_ENV=production AND this is "true".
PUBLIC_INDEXING=false
# Demo fixtures render in development only. Must be false in production.
ALLOW_DEMO_CONTENT=true
# Optional: password-protect the whole site (preview deployments). Empty = off.
SITE_ACCESS_PASSWORD=

# Internal fulfilment console (HTTP Basic auth). Internal routes are disabled if unset.
INTERNAL_USER=team
INTERNAL_PASSWORD=change-me
# HMAC secret for customer status-page links. Required.
REQUEST_TOKEN_SECRET=change-me-to-a-long-random-string
# SQLite file for the development request store.
DATABASE_PATH=data/dev.sqlite

# Payments: only "demo" is implemented. No card data is collected in demo mode.
PAYMENTS_MODE=demo
# Sharetribe: not connected in this session. Leave blank; the development adapter is used.
SHARETRIBE_CLIENT_ID=
SHARETRIBE_CLIENT_SECRET=
SHARETRIBE_INTEGRATION_CLIENT_ID=
SHARETRIBE_INTEGRATION_CLIENT_SECRET=

# Email via Resend (docs/EMAIL.md). Test mode sends everything to EMAIL_TEST_RECIPIENT.
RESEND_API_KEY=
EMAIL_MODE=test
EMAIL_TEST_RECIPIENT=qa@carnivalriderental.us
EMAIL_ADMIN_RECIPIENT=
EMAIL_UNSUBSCRIBE_SECRET=
# Required before any outreach (CAN-SPAM):
BUSINESS_POSTAL_ADDRESS=
# Founder-approved outreach campaigns, comma-separated (live mode only):
EMAIL_APPROVED_CAMPAIGNS=

# Request desk listing (house account, inquiry-only) and hosted marketplace base URL. Public values.
REQUEST_DESK_LISTING_ID=
SHARETRIBE_MARKETPLACE_URL=
