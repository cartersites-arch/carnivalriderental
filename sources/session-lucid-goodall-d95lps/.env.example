# Copy to .env.local for development. Never commit real values.

# Absolute site origin used for canonical URLs and the sitemap.
SITE_URL=http://127.0.0.1:3000

# Public indexing is OFF unless this is exactly "on". Leave it off in every
# development and preview environment.
SITE_INDEXING=off

# Show development fixture records (demo rides/cities) on public pages.
# Fixtures are never included in the sitemap and always render noindex.
SHOW_FIXTURES=on

# Internal team area (/internal, /api/internal/*) uses HTTP Basic auth.
# If either value is missing the internal area refuses every request.
INTERNAL_USER=
INTERNAL_PASSWORD=

# SQLite file for the development backend.
DATABASE_PATH=.data/dev.sqlite

# Sharetribe Marketplace API (not connected in session one). While these are
# empty the app uses the explicitly labelled development adapter.
NEXT_PUBLIC_SHARETRIBE_SDK_CLIENT_ID=
