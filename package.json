{
  "name": "book-a-carnival",
  "version": "0.1.0",
  "private": true,
  "description": "Managed carnival ride rental marketplace (development). Working brand 'Book a Carnival' is a placeholder.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/check-content.ts",
    "setup": "tsx scripts/setup.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "sharetribe:check": "tsx --env-file-if-exists=.env.local scripts/sharetribe-check.ts",
    "sharetribe:inspect": "tsx --env-file-if-exists=.env.local scripts/sharetribe-inspect.ts",
    "contract:diff": "tsx scripts/contract-diff.ts",
    "catalog:seed": "tsx --env-file-if-exists=.env.local scripts/catalog-seed.ts",
    "catalog:search-proof": "tsx --env-file-if-exists=.env.local scripts/catalog-search-proof.ts",
    "import:companies": "tsx --env-file-if-exists=.env.local scripts/company-import.ts",
    "import:listings": "tsx --env-file-if-exists=.env.local scripts/listing-import.ts",
    "email:dispatch": "tsx --env-file-if-exists=.env.local scripts/email-dispatch.ts",
    "email:claim-invites": "tsx --env-file-if-exists=.env.local scripts/claim-invites.ts",
    "import:photos": "tsx --env-file-if-exists=.env.local scripts/photo-import.ts",
    "listings:enable-inquiry": "tsx --env-file-if-exists=.env.local scripts/listing-enable-inquiry.ts",
    "desk:setup": "tsx --env-file-if-exists=.env.local scripts/request-desk.ts setup",
    "desk:list": "tsx --env-file-if-exists=.env.local scripts/request-desk.ts list",
    "desk:show": "tsx --env-file-if-exists=.env.local scripts/request-desk.ts show",
    "desk:reply": "tsx --env-file-if-exists=.env.local scripts/request-desk.ts reply",
    "ops:claim": "tsx --env-file-if-exists=.env.local scripts/operator-claim.ts",
    "qa:operator": "tsx --env-file-if-exists=.env.local scripts/qa-operator.ts",
    "ops:bookable": "tsx --env-file-if-exists=.env.local scripts/operator-bookable.ts",
    "qa:journey": "tsx --env-file-if-exists=.env.local scripts/qa-journey.ts",
    "qa:payment": "tsx --env-file-if-exists=.env.local scripts/qa-payment.ts",
    "stripe:probe": "tsx --env-file-if-exists=.env.local scripts/stripe-probe.ts",
    "ops:anonymize": "tsx --env-file-if-exists=.env.local scripts/operator-anonymize.ts",
    "inventory:export": "tsx --env-file-if-exists=.env.local scripts/inventory-export.ts",
    "geo:cities": "python3 scripts/cities-build.py",
    "inventory:validate": "tsx scripts/inventory-validate.ts",
    "pseo:report": "tsx scripts/pseo-report.ts"
  },
  "dependencies": {
    "lucide-react": "^0.522.0",
    "next": "15.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
